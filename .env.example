# ============================================================================
# Candy Loz (كاندي لوز) — Production & Backend Connection Environment Template
# Copy to .env.local (Next.js) and /backend/.env (Django) — NEVER commit real secrets.
# ============================================================================

# --- Public Frontend URLs ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_ENABLE_MOCK_STORAGE=false

# --- Next.js <-> Django Backend Connection (Server-Only Secrets) ---
# Set BACKEND_API_URL to your Django server origin (e.g. https://api.candyloz.com or http://127.0.0.1:8000)
BACKEND_API_URL=
BACKEND_INTERNAL_SECRET=
BACKEND_STRICT_PROXY=false

# --- Next.js Server Auth & Runtime Controls (Server-Only Secrets) ---
JWT_SECRET=
INITIAL_ADMIN_PASSWORD=
ALLOW_DEMO_LOGIN=false
ALLOW_DEV_TOOLS=false
CANDY_LOZ_DB_PATH=

# --- Django Backend Secrets & Infrastructure (/backend) ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
REDIS_URL=