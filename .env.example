# Candy Loz Store - Environment Configuration Template
# IMPORTANT: DO NOT commit actual secrets, passwords, or production API keys to this file or to git.

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Security & Sessions (Production Only - server-side secrets)
# SESSION_SECRET=example-secret-must-be-at-least-32-chars-long
# JWT_SECRET=example-jwt-signing-secret

# Mock Mode Configuration (true/false)
NEXT_PUBLIC_ENABLE_MOCK_STORAGE=true
